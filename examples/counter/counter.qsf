# SPDX-License-Identifier: GPL-3.0-only
#
# Assignments for the counter demonstration project.
#
# No pin locations are set here: they belong to a particular board and this
# example does not assume one. Quartus places the I/O automatically, and the
# fitted pinout ends up in output_files/counter.pin. For real hardware, add
# the locations your board needs, for example:
#
#     set_location_assignment PIN_27 -to clk
#     set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M04SAE144A7G
set_global_assignment -name TOP_LEVEL_ENTITY counter_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# Three languages in one hierarchy, on purpose.
set_global_assignment -name SYSTEMVERILOG_FILE src/counter_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/debouncer.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/updown_counter.sv
set_global_assignment -name VERILOG_FILE src/clk_tick.v
set_global_assignment -name VHDL_FILE src/seven_seg_decoder.vhd

set_global_assignment -name SDC_FILE counter.sdc

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"